# Option 1: Gunakan Gemini API secara langsung untuk analisis berbasis AI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Option 2: Gunakan layanan analisis eksternal pihak ketiga (opsional)
# VERIFTOK_ANALYZER_URL=https://your-analyzer-service.com/api/analyze
# VERIFTOK_ANALYZER_TOKEN=your_bearer_token_here

# Catatan: Jika tidak ada API key yang dikonfigurasi, VerifTok akan secara otomatis
# menggunakan Mesin Analisis Cerdas bawaan (Smart Built-in Analyzer) untuk memproses
# meta data TikTok, memberikan skor provokasi, pemeriksaan klaim/hoax, dan merangkum nada komentar.
